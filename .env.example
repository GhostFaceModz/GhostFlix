# GhostFlix configuration — copy to .env for local dev (Render: set in the dashboard).
PORT=3000
# TMDB v3 API key OR v4 read access token (free: https://www.themoviedb.org/settings/api). Empty = demo catalog.
TMDB_API_KEY=
TMDB_REGION=US
TMDB_LANGUAGE=en-US
# Admin page (/admin). Leave empty to disable admin entirely.
ADMIN_PASSWORD=
# Random string used to sign admin sessions (optional but recommended).
SESSION_SECRET=
# Optional: free YouTube Data API v3 key — lets Import read whole playlists/channels (otherwise latest ~15 videos).
YOUTUBE_API_KEY=
# Optional: Supabase Auth for sign-in (Google/Discord) + watchlist/history sync. Public values (anon/publishable key).
SUPABASE_PUBLIC_URL=
SUPABASE_ANON_KEY=
# AUTH_GOOGLE=false / AUTH_DISCORD=false hide a provider button
# Optional community links
DISCORD_INVITE_URL=
GITHUB_URL=
# Optional: secret for POST /api/cron/resync (external free cron, header x-cron-secret)
CRON_SECRET=
# Optional server-side persistence of the admin store (SERVER ONLY — service key bypasses RLS)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Watch Parties (experimental, off by default). 1 = show /party, menu link and 'Watch together'.
ENABLE_WATCH_PARTIES=
